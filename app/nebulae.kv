        text_color: 1, 1, 1, 1
        on_release: app.change_screen('main')

    Label:
        text: "AI Assistant"
        font_name: 'BayerType'
        font_size: root.height * 0.11
        bold: True
        color: 0.117647, 0.239215, 0.345098, 1
        letter_spacing: 4
        size_hint_y: None
