<VideosScreen>:
    FloatLayout:

        # --- Background image ---
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'assets/images/bg.png'

        # --- Your BoxLayout content ---
        BoxLayout:
            orientation: "vertical"
            padding: root.height * 0.03
            spacing: root.height * 0.02
            size_hint: 1, 1

            # Title
            Label:
                text: "Videos"
                font_name: 'BayerType'
                font_size: root.height * 0.11
                bold: True
                color: 0.117647, 0.239215, 0.345098, 1
                letter_spacing: 4
                size_hint_y: None
                height: self.texture_size[1] + root.height * 0.04
                pos_hint: {"top": 1}

            Widget:   # Spacer so layout doesn't collapse

        # --- Back Button (floats above layout) ---
        MDRaisedButton:
            text: "Back"
            pos_hint: {"x": 0.02, "y": 0.92}
            size_hint: None, None
            size: 120, 48
            md_bg_color: 0.117647, 0.239215, 0.345098, 1
            text_color: 1, 1, 1, 1
            on_release: app.root.current = 'home'

        # --- VideoPlayer OVERLAY (always on top) ---
        VideoPlayer:
            id: player
            source: "assets/videos/testvideo.mp4"
            state: "play"
            options: {"eos": "loop"}

            size_hint: None, None
            size: root.width * 0.8, root.height * 0.4
            pos_hint: {"center_x": 0.5, "center_y": 0.45}

            allow_stretch: True
            keep_ratio: False